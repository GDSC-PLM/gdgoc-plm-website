# Server-only values from your Supabase project's Connect / API Keys settings.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# CMS development uses only the loopback Supabase stack.
CMS_SUPABASE_URL=http://127.0.0.1:54321
CMS_SUPABASE_PUBLISHABLE_KEY=
CMS_SUPABASE_SECRET_KEY=

# Export these before starting Supabase. The placeholders allow offline fixture checks.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=local-fixtures-only
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=local-fixtures-only
